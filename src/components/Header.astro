---
import { NAV, SITE } from '../site.config';
import Logo from './Logo.astro';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath.startsWith(href);
---

<header class="site-header">
	<div class="bar">
		<a href="/" class="wordmark">
			<Logo size={24} />
			<span>{SITE.name}</span>
		</a>
		<nav aria-label="Primary">
			<ul>
				{
					NAV.map(({ href, label }) => (
						<li>
							<a href={href} aria-current={isActive(href) ? 'page' : undefined}>
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		position: fixed;
		inset: 0.5rem 0 auto;
		z-index: 50;
		padding-inline: var(--gutter);
		view-transition-name: site-header;
		pointer-events: none;
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: calc(var(--shell) + 2.5rem);
		height: 3.25rem;
		margin-inline: auto;
		padding-inline: 1.25rem 0.5rem;
		border: 1px solid var(--rule);
		border-radius: 999px;
		background: color-mix(in oklab, var(--white) 86%, transparent);
		backdrop-filter: blur(14px) saturate(1.8);
		-webkit-backdrop-filter: blur(14px) saturate(1.8);
		box-shadow: var(--lift);
		pointer-events: auto;
	}

	.wordmark {
		display: inline-flex;
		align-items: center;
		gap: 0.65rem;
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 750;
		letter-spacing: -0.02em;
	}

	ul {
		display: flex;
		gap: 0.25rem;
	}

	ul a {
		display: inline-flex;
		align-items: center;
		height: 2.4rem;
		padding-inline: 0.95rem;
		border-radius: 999px;
		font-size: var(--t-ui);
		font-weight: 600;
		color: var(--body);
		transition:
			background-color 0.2s var(--ease),
			color 0.2s var(--ease);
	}

	ul a:hover {
		color: var(--ink);
		background: var(--band);
	}

	ul a[aria-current='page'] {
		color: var(--white);
		background: var(--ink);
	}

	@media (max-width: 600px) {
		.bar {
			padding-inline: 0.9rem 0.4rem;
		}

		.wordmark span {
			display: none;
		}

		ul a {
			height: 2.3rem;
			padding-inline: 0.7rem;
		}
	}
</style>
