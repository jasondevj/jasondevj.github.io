---
const lines = [
	{ id: 'ae', code: 'AE', d: 'M24 70 H110 L200 160 V300 L130 370 H44', badge: { x: 0, y: 352 } },
	{ id: 'sa', code: 'SA', d: 'M240 26 V414', badge: { x: 216, y: 0 } },
	{ id: 'hs', code: 'HS', d: 'M456 90 H370 L280 180 V290 L350 360 H436', badge: { x: 432, y: 342 } },
];

const stations = [
	{ line: 'ae', x: 62, y: 70 },
	{ line: 'ae', x: 200, y: 290 },
	{ line: 'sa', x: 240, y: 84 },
	{ line: 'sa', x: 240, y: 150 },
	{ line: 'sa', x: 240, y: 360 },
	{ line: 'hs', x: 418, y: 90 },
	{ line: 'hs', x: 394, y: 360 },
];
---

<svg class="hero-map" viewBox="0 0 480 440" role="img" aria-label="Three coloured lines, one for each topic, meeting at a single interchange">
	{
		lines.map(({ id, d }, index) => (
			<path class={`track line-${id}`} d={d} pathLength="1" style={`--i: ${index}`} />
		))
	}
	{stations.map(({ line, x, y }) => <circle class={`stop line-${line}`} cx={x} cy={y} r="9" />)}
	<rect class="hub" x="176" y="199" width="128" height="42" rx="21"></rect>
	{
		lines.map(({ id, code, badge }) => (
			<g class={`terminus line-${id}`} transform={`translate(${badge.x} ${badge.y})`}>
				<rect width="48" height="28" rx="14" />
				<text x="24" y="19">
					{code}
				</text>
			</g>
		))
	}
</svg>

<style>
	.hero-map {
		width: 100%;
		max-width: 30rem;
		height: auto;
		overflow: visible;
	}

	.track {
		fill: none;
		stroke: var(--c);
		stroke-width: 16;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.stop {
		fill: var(--white);
		stroke: var(--c);
		stroke-width: 5;
	}

	.hub {
		fill: var(--white);
		stroke: var(--ink);
		stroke-width: 6;
	}

	.terminus rect {
		fill: var(--tint);
	}

	.terminus text {
		fill: var(--cink);
		font-family: var(--font-sans);
		font-size: 14px;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-anchor: middle;
	}

	@media (prefers-reduced-motion: no-preference) {
		.track {
			stroke-dasharray: 1;
			stroke-dashoffset: 1;
			animation: draw 1.1s var(--ease) forwards;
			animation-delay: calc(var(--i) * 160ms);
		}

		.stop,
		.hub,
		.terminus {
			transform-box: fill-box;
			transform-origin: center;
			animation: pop 360ms cubic-bezier(0.3, 1.5, 0.5, 1) both;
			animation-delay: 900ms;
		}

		.hub {
			animation-delay: 1050ms;
		}

		.terminus {
			animation-delay: 1150ms;
		}
	}

	@keyframes draw {
		to {
			stroke-dashoffset: 0;
		}
	}

	@keyframes pop {
		from {
			opacity: 0;
			scale: 0.4;
		}
	}
</style>
