---
import { NAV, SITE, SOCIAL } from '../site.config';
import Logo from './Logo.astro';

const elsewhere = [
	{ href: SOCIAL.linkedin, label: 'LinkedIn' },
	{ href: SOCIAL.github, label: 'GitHub' },
	{ href: SOCIAL.medium, label: 'Medium' },
	{ href: SOCIAL.x, label: 'X' },
].filter(({ href }) => href);

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="shell row">
		<a href="/" class="wordmark" aria-label={`${SITE.name}, home`}>
			<Logo size={20} />
		</a>
		<nav aria-label="Footer">
			<ul>
				{
					NAV.map(({ href, label }) => (
						<li>
							<a href={href}>{label}</a>
						</li>
					))
				}
				<li><a href="/tags/">Tags</a></li>
				<li><a href="/rss.xml">RSS</a></li>
				{
					elsewhere.map(({ href, label }) => (
						<li>
							<a href={href} rel="me noopener" target="_blank">
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<p class="colophon">© {year} {SITE.name}, {SITE.location}</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: clamp(1.5rem, 3vw, 2rem);
		padding-block: 0.9rem;
		background: var(--band);
	}

	.row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1.5rem;
	}

	.wordmark {
		display: inline-flex;
	}

	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
	}

	ul a {
		font-size: var(--t-small);
		font-weight: 600;
		color: var(--body);
	}

	ul a:hover {
		color: var(--link);
	}

	.colophon {
		margin-left: auto;
		font-size: var(--t-small);
		color: var(--quiet);
	}
</style>
