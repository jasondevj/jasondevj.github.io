---
import Icon from '../Icon.astro';

interface Props {
	src: string;
	title: string;
}

const { src, title } = Astro.props;
---

<figure class="slides">
	<div class="frame">
		<iframe src={src} title={`Slides: ${title}`} loading="lazy" allowfullscreen></iframe>
	</div>
	<figcaption>
		<span>Click into the slides and use the arrow keys to move through them.</span>
		<a class="open" href={src}>Open full screen <Icon name="arrow-up-right" /></a>
	</figcaption>
</figure>

<style>
	.slides {
		margin: 0;
		font-family: var(--font-sans);
	}

	.frame {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: var(--radius-l);
		background: var(--ink);
		box-shadow: var(--lift);
	}

	iframe {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
	}

	figcaption {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1rem;
		margin-top: 0.7rem;
		font-size: var(--t-small);
		color: var(--quiet);
	}

	.slides .open {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-weight: 700;
		color: var(--link);
		text-decoration: none;
	}

	.open :global(.icon) {
		width: 0.85rem;
		height: 0.85rem;
	}
</style>
