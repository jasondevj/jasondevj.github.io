---
import Footer from '../components/Footer.astro';
import Head, { type SeoProps } from '../components/Head.astro';
import Header from '../components/Header.astro';
import { SITE } from '../site.config';

type Props = SeoProps;
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<Head {...Astro.props} />
		<slot name="head" />
	</head>
	<body>
		<a class="skip-link" href="#content">Skip to content</a>
		<Header />
		<main id="content">
			<slot />
		</main>
		<Footer />
	</body>
</html>
