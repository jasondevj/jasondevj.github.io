---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import LinkedInMark from '../components/LinkedInMark.astro';
import YouTubeMark from '../components/YouTubeMark.astro';
import { breadcrumbSchema, profilePageSchema } from '../lib/schema';
import { SITE, SOCIAL } from '../site.config';

const roles = [
	SITE.role,
	'Technical Lead',
	'Vice President, IT and Digital Business',
	'Enterprise and Solutions Architect',
	'Account Manager, APAC',
	'Senior Software Engineer',
];

const talks = [
	{
		title: 'Stop Tuning Your RAG, Start Orchestrating It',
		event: 'Data Engineering Singapore meetup, hosted at Crédit Agricole CIB',
		year: '4 June 2026',
		recap: 'https://www.linkedin.com/feed/update/urn:li:ugcPost:7470024234216538112/',
		slides: '/talks/stop-tuning-your-rag/',
		post: '/blog/stop-tuning-your-rag-start-orchestrating-it/',
	},
	{
		title: "APIs Don't Make Money",
		event: 'Webinar for hSenid Mobile',
		year: 'January 2016',
		video: 'https://www.youtube.com/watch?v=k7d_iCGZRns',
		post: '/blog/apis-dont-make-money-services-do/',
	},
];

const elsewhere = [
	{ href: SOCIAL.linkedin, label: 'LinkedIn' },
	{ href: SOCIAL.github, label: 'GitHub' },
	{ href: SOCIAL.medium, label: 'Medium' },
].filter(({ href }) => href);
---

<Base
	title="About"
	description={`${SITE.name} is a ${SITE.role.toLowerCase()} in ${SITE.location} with more than 15 years across ${SITE.sectors.join(', ').toLowerCase()}, writing about AI engineering, systems and developer experience.`}
	type="profile"
	jsonLd={[
		profilePageSchema(),
		breadcrumbSchema([
			{ name: 'Home', path: '/' },
			{ name: 'About', path: '/about/' },
		]),
	]}
>
	<section class="shell page-head">
		<h1>About</h1>
		<p class="lede">{SITE.role} in {SITE.location}, writing about AI engineering, systems and the people who build them.</p>
	</section>

	<div class="shell about">
		<div class="bio">
			<p>
				I'm Jason Jebanesan, a {SITE.role.toLowerCase()} in {SITE.location}. I like problems where reliable systems meet
				the people who depend on them.
			</p>
			<p>
				I've worked in technology for more than 15 years, across telco, banking and healthcare. Along the way I've been a
				software engineer, an account manager for clients across APAC, an enterprise and solutions architect, the head of IT
				and digital business, and a technical lead. Each role widened what I was responsible for, and programming stayed
				the constant.
			</p>
			<p>
				Through all of that, most of my code has gone into the JVM: high-throughput HTTP clients, rule engines, single
				sign-on, and the plumbing that keeps large systems honest. Lately my focus has moved to AI engineering: agent workflows that stay simple, RAG pipelines that hold up in
				production, and the guardrails teams need now that AI writes a share of their code.
			</p>
			<p>
				I've blogged for a long time in different corners of the internet. This site is where all of it lives now. I write
				to think clearly, to pass on what I learned the hard way, and to start conversations with people working on the
				same problems.
			</p>
			<p>
				If you'd like to talk about a project, a speaking slot, or anything you've read here, <a
					class="link"
					href={SOCIAL.linkedin}
					target="_blank"
					rel="me noopener">message me on LinkedIn</a
				>.
			</p>
		</div>

		<aside class="facts">
			<section aria-labelledby="experience">
				<h2 id="experience">Experience</h2>
				<ul class="sectors" aria-label="Sectors">
					{SITE.sectors.map((sector) => <li>{sector}</li>)}
				</ul>
				<ol class="roles" aria-label="Roles, most recent first">
					{
						roles.map((role, index) => (
							<li>
								{index === 0 && <p class="now">Now</p>}
								<p class="what">{role}</p>
							</li>
						))
					}
				</ol>
			</section>

			<section aria-labelledby="speaking">
				<h2 id="speaking">Speaking</h2>
				<ul class="talks">
					{
						talks.map(({ title, event, year, recap, slides, video }) => (
							<li>
								<p class="what">{title}</p>
								<p class="where">
									{event}, {year}
								</p>
								<p class="talk-links">
									{slides && (
										<a class="talk-link" href={slides}>
											<Icon name="presentation" />
											View the slides
										</a>
									)}
									{video && (
										<a class="talk-link video" href={video} target="_blank" rel="noopener">
											<YouTubeMark />
											Watch on YouTube
										</a>
									)}
									{recap && (
										<a class="talk-link recap" href={recap} target="_blank" rel="noopener">
											<LinkedInMark />
											Event recap on LinkedIn
										</a>
									)}
								</p>
							</li>
						))
					}
				</ul>
			</section>

			<section aria-labelledby="elsewhere">
				<h2 id="elsewhere">Elsewhere</h2>
				<ul class="links">
					{
						elsewhere.map(({ href, label }) => (
							<li>
								<a class="link" href={href} target="_blank" rel="me noopener">
									{label}
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</aside>
	</div>
</Base>

<style>
	.about {
		display: grid;
		grid-template-columns: minmax(0, var(--measure)) minmax(0, 20rem);
		justify-content: space-between;
		gap: clamp(2.5rem, 7vw, 6rem);
	}

	.bio p {
		font-size: var(--t-read);
		line-height: 1.75;
	}

	.bio p + p {
		margin-top: 1.2em;
	}

	.bio p:first-child {
		font-size: 1.5rem;
		line-height: 1.5;
	}

	.facts section + section {
		margin-top: 2.75rem;
	}

	h2 {
		padding-bottom: 0.6rem;
		margin-bottom: 1.1rem;
		font-size: var(--t-h4);
		border-bottom: 1px solid var(--rule-strong);
	}

	.sectors {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 1.4rem;
	}

	.sectors li {
		padding: 0.3rem 0.75rem;
		border-radius: 999px;
		background: var(--tint);
		color: var(--cink);
		font-size: var(--t-small);
		font-weight: 650;
	}

	.roles,
	.sectors {
		--c: var(--line-sa);
		--tint: color-mix(in oklab, var(--line-sa) 12%, white);
		--cink: #1f4fd1;
	}

	.roles {
		position: relative;
	}

	.roles::before {
		content: '';
		position: absolute;
		left: 0.4rem;
		top: 0.6rem;
		bottom: 0.6rem;
		width: 5px;
		background: var(--c);
	}

	.roles li {
		position: relative;
		padding-left: 2.1rem;
	}

	.roles li + li {
		margin-top: 1rem;
	}

	.roles li::before {
		content: '';
		position: absolute;
		left: 0.15rem;
		top: 0.3rem;
		width: 1.05rem;
		height: 1.05rem;
		border: 4px solid var(--c);
		border-radius: 50%;
		background: var(--station-fill);
		box-sizing: border-box;
	}

	.now {
		font-size: var(--t-small);
		color: var(--quiet);
	}

	.what {
		font-weight: 600;
	}

	.where {
		font-size: var(--t-ui);
		color: var(--quiet);
	}

	.talk-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.6rem;
	}

	.talk-link {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		height: 2.1rem;
		padding-inline: 0.8rem 0.95rem;
		border-radius: 999px;
		background: var(--ink);
		color: var(--white);
		font-size: var(--t-small);
		font-weight: 650;
		transition: background-color 0.2s var(--ease);
	}

	.talk-link:hover {
		background: #2c3142;
	}

	.talk-link.recap {
		background: #0a66c2;
	}

	.talk-link.recap:hover {
		background: #004182;
	}

	.talk-link.video {
		background: #c4302b;
	}

	.talk-link.video:hover {
		background: #a3241f;
	}

	.talk-link :global(svg) {
		width: 1rem;
		height: 1rem;
	}

	.talks li + li {
		margin-top: 1rem;
	}

	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
	}

	@media (max-width: 900px) {
		.about {
			grid-template-columns: 1fr;
		}
	}
</style>
